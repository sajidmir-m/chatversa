{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "installCommand": "npm install --prefix frontend && npm install --prefix backend",
  "buildCommand": "npm run vercel-build --prefix backend",
  "outputDirectory": "backend/public",
  "functions": {
    "src/server.ts": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/((?!api|socket.io|health|assets|favicon).*)",
      "destination": "/index.html"
    }
  ]
}
